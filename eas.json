{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.kcalai.link"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.kcalai.link"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.kcalai.link"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6819191246"
      },
      "android": {
        "serviceAccountKeyPath": "../../keys/play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
